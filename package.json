{
  "name": "newrelic-logger",
  "version": "1.0.0",
  "description": "Number to words converter for 137 locales: amounts in words for invoices and cheques, currency, ordinals and BigInt (TypeScript, ESM/CJS/UMD).",
  "keywords": [
    "logger",
    "newrelic"
  ],
  "bugs": {
    "url": "https://github.com/manojchrsya/newrelic-logger/issues"
  },
  "license": "MIT",
  "author": "Manoj Chaurasiya",
  "repository": {
    "type": "git",
    "url": "https://github.com/manojchrsya/newrelic-logger.git"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "scripts": {
    "bench": "vitest bench",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:umd && npm run build:pkgjson && npm run build:cli",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:cli": "chmod +x dist/cjs/cli.js",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:pkgjson": "echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:umd": "node --experimental-strip-types scripts/build-umd.ts",
    "build:watch": "npm run build -- --watch",
    "clean": "rimraf dist coverage",
    "commit": "git-cz",
    "docs:build": "npm run docs:check && vitepress build docs && npm run docs:verify",
    "docs:check": "npm run build:esm && node scripts/generate-locale-docs.mjs --check",
    "docs:dev": "vitepress dev docs",
    "docs:generate": "npm run build:esm && node scripts/generate-locale-docs.mjs && npm run build:esm",
    "docs:preview": "vitepress preview docs",
    "docs:verify": "node scripts/check-docs-build.mjs",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "size:check": "npm run build:umd -- --verbose",
    "test": "vitest",
    "test:package": "node scripts/package-smoke.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:watch": "npm run test -- --watch"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/source-map-support": "^0.5.10",
    "@vitest/coverage-v8": "^5.0.5",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lodash": "^4.18.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.15",
    "source-map-support": "^0.5.21",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "commitizen": {
      "lodash": "4.17.23"
    },
    "tmp": "0.2.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
