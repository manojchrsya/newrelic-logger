{
  "name": "newrelic-transport",
  "version": "1.1.1",
  "description": "Drop-in HTTP request logger that ships request logs to New Relic (Express, Fastify, Koa, NestJS, plain http)",
  "keywords": [
    "newrelic",
    "logging",
    "request-logger",
    "express",
    "fastify",
    "koa",
    "nestjs",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/manojchrsya/newrelic-transport/issues"
  },
  "homepage": "https://github.com/manojchrsya/newrelic-transport#readme",
  "license": "MIT",
  "author": "Manoj Chaurasiya",
  "repository": {
    "type": "git",
    "url": "https://github.com/manojchrsya/newrelic-transport.git"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "bench": "vitest bench",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:pkgjson",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:pkgjson": "echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:watch": "npm run build -- --watch",
    "clean": "rimraf dist coverage",
    "commit": "git-cz",
    "docs:build": "npm run docs:check && vitepress build docs && npm run docs:verify",
    "docs:check": "npm run build:esm && node scripts/generate-locale-docs.mjs --check",
    "docs:dev": "vitepress dev docs",
    "docs:generate": "npm run build:esm && node scripts/generate-locale-docs.mjs && npm run build:esm",
    "docs:preview": "vitepress preview docs",
    "docs:verify": "node scripts/check-docs-build.mjs",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "size:check": "npm run build:esm -- --verbose",
    "test": "vitest",
    "test:package": "node scripts/package-smoke.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:watch": "npm run test -- --watch"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/source-map-support": "^0.5.10",
    "@vitest/coverage-v8": "^5.0.5",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lodash": "^4.18.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.15",
    "source-map-support": "^0.5.21",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "commitizen": {
      "lodash": "4.17.23"
    },
    "tmp": "0.2.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@koa/router": "^15.7.1",
    "@nestjs/core": "^12.3.3",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "koa": "^3.3.0",
    "koa-router": "^14.0.0"
  }
}
